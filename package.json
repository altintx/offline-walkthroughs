{
  "name": "offline-walkthroughs",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "test": "node --test --test-isolation=none tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "test:reader": "playwright test",
    "format": "prettier --write App.tsx src modules/controller/index.ts scripts"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-asset": "~12.0.9",
    "expo-dev-client": "~6.0.0",
    "expo-document-picker": "~14.0.0",
    "expo-file-system": "~19.0.0",
    "expo-font": "~14.0.12",
    "expo-modules-core": "~3.0.30",
    "expo-sqlite": "~16.0.0",
    "expo-status-bar": "~3.0.0",
    "expo-system-ui": "~6.0.9",
    "htmlparser2": "^10.1.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-webview": "13.15.0",
    "walkthrough-controller": "file:modules/controller"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "~19.1.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "overrides": {
    "react-native": "$react-native",
    "react": "$react"
  }
}
